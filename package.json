{
  "name": "meeting-room-calendar",
  "version": "1.6.0",
  "description": "Десктопное приложение для просмотра занятости переговорных комнат из Exchange (EWS)",
  "main": "src/main/index.js",
  "author": "Enremservice",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "check": "node --check src/main/index.js && node --check src/main/ews-client.js && node --check src/main/config.js && node --check src/preload.js && node --check src/renderer/app.js",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "@ewsjs/xhr": "^3.0.4",
    "dotenv": "^17.2.2",
    "electron-updater": "^6.8.9",
    "ews-javascript-api": "^0.15.3"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4"
  },
  "overrides": {
    "undici": "^6.28.1",
    "uuid": "^11.1.1"
  },
  "build": {
    "appId": "ru.enremservice.meetingrooms",
    "productName": "ERS_MEETING_ROOM",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "config/rooms.json",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ERS_MEETING_ROOM",
      "artifactName": "ERS_MEETING_ROOM_INSTALLER.${ext}",
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "DudeMSK",
      "repo": "service_for_meeting_rooms",
      "private": true
    }
  }
}
