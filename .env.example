# Скопируйте файл в .env и заполните секреты. .env исключен из Git.
EWS_EMAIL=service-account@example.org
EWS_USERNAME=DOMAIN\\service-account
EWS_PASSWORD=change-me
EWS_SERVER=mail.example.org
EWS_AUTH=ntlm
TZ=Europe/Moscow

# Календари, к которым у учетной записи есть право чтения (через запятую).
EWS_MAILBOXES=secretary@example.org,user@example.org,department@example.org

# Необязательно: период фонового обновления в минутах.
REFRESH_MINUTES=5

# Необязательно: путь EWS. Обычно менять не нужно.
EWS_PATH=/EWS/Exchange.asmx

# Необязательно: токен GitHub (Fine-grained PAT, доступ только к репозиторию
# DudeMSK/service_for_meeting_rooms, право "Contents: Read-only") — нужен для
# публикации релизов (npm run dist -- --publish always) и для проверки
# обновлений внутри самого приложения (репозиторий приватный, без токена
# GitHub Releases недоступны). Без токена приложение работает как обычно,
# просто кнопка "Проверить обновления" будет сообщать, что обновления не
# настроены.
GH_TOKEN=

# Fireflies встроен в это же приложение. Ключ хранится зашифрованно после
# первого сохранения настроек. Можно ввести его в окне «Настройки → Fireflies»
# или задать здесь для первичного переноса.
FIREFLIES_ENABLED=true
FIREFLIES_API_KEY=
FIREFLIES_POLL_SECONDS=60
FIREFLIES_JOIN_LEAD_MINUTES=1
VERIFY_DELAY_MINUTES=5
VERIFY_MAX_ATTEMPTS=3
VERIFY_RETRY_MINUTES=5
